# The vendored crate trees are generated by scripts/vendor.py, not written.
# They are committed only because `[patch.crates-io]` needs the path to exist
# before `cargo build` runs; the reviewable artefact is the patch that produced
# them. Marking them keeps tens of thousands of derived lines out of language
# statistics and out of review diffs.
vendor/** linguist-vendored=true -diff

# ...but not the parts a human actually writes and reads. These are the source
# the trees above are derived from, so they must diff and must count.
vendor/README.md    linguist-vendored=false diff
vendor/Vendor.toml  linguist-vendored=false diff
vendor/patches/**   linguist-vendored=false diff

# Generated, but small and worth reading in a diff: it is the evidence that a
# tree still matches its patch.
vendor/Vendor.lock  linguist-generated=true diff
